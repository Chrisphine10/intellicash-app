{
  "_about": "One loan, its repayments, and what is owed on a given day. The server (apps/api/src/domain/loan-math.ts memberLoanPosition) and the phone (lib/core/utils/loan_accrual.dart) must both reproduce every figure. Days count from 2026-01-01T00:00:00Z; a month is 30 days; interest is charged per COMPLETED month, capped at the term; FLAT charges rate x original principal each month, REDUCING charges rate x principal unpaid at the start of the month (money paid in a month clears booked interest first, then principal, and a payment exactly at a month end counts in the next month). A repayment that covers everything owed at that moment settles the loan and stops its interest; anything beyond is an overpayment. Worked by hand, not generated. Copy kept in intellicash_mobile/test/fixtures/.",
  "cases": [
    { "name": "flat, disbursement day", "loan": { "principalCents": 100000, "interestRateBps": 1000, "termMonths": 3, "interestType": "FLAT" }, "repayments": [], "asOfDay": 0,
      "expect": { "interestCents": 0, "repaidCents": 0, "outstandingCents": 100000, "overpaidCents": 0, "settled": false } },
    { "name": "flat, day 29 - no month completed", "loan": { "principalCents": 100000, "interestRateBps": 1000, "termMonths": 3, "interestType": "FLAT" }, "repayments": [], "asOfDay": 29,
      "expect": { "interestCents": 0, "repaidCents": 0, "outstandingCents": 100000, "overpaidCents": 0, "settled": false } },
    { "name": "flat, day 30 - one month", "loan": { "principalCents": 100000, "interestRateBps": 1000, "termMonths": 3, "interestType": "FLAT" }, "repayments": [], "asOfDay": 30,
      "expect": { "interestCents": 10000, "repaidCents": 0, "outstandingCents": 110000, "overpaidCents": 0, "settled": false } },
    { "name": "flat, day 95 - three months", "loan": { "principalCents": 100000, "interestRateBps": 1000, "termMonths": 3, "interestType": "FLAT" }, "repayments": [], "asOfDay": 95,
      "expect": { "interestCents": 30000, "repaidCents": 0, "outstandingCents": 130000, "overpaidCents": 0, "settled": false } },
    { "name": "flat, long overdue - capped at term", "loan": { "principalCents": 100000, "interestRateBps": 1000, "termMonths": 3, "interestType": "FLAT" }, "repayments": [], "asOfDay": 400,
      "expect": { "interestCents": 30000, "repaidCents": 0, "outstandingCents": 130000, "overpaidCents": 0, "settled": false } },
    { "name": "flat, part repaid - interest stays on original principal", "loan": { "principalCents": 100000, "interestRateBps": 1000, "termMonths": 3, "interestType": "FLAT" }, "repayments": [{ "day": 10, "cents": 50000 }], "asOfDay": 65,
      "expect": { "interestCents": 20000, "repaidCents": 50000, "outstandingCents": 70000, "overpaidCents": 0, "settled": false } },
    { "name": "flat, overpaid - settled and surplus kept", "loan": { "principalCents": 100000, "interestRateBps": 1000, "termMonths": 1, "interestType": "FLAT" }, "repayments": [{ "day": 40, "cents": 120000 }], "asOfDay": 90,
      "expect": { "interestCents": 10000, "repaidCents": 120000, "outstandingCents": 0, "overpaidCents": 10000, "settled": true } },
    { "name": "reducing, no repayment - same as flat", "loan": { "principalCents": 100000, "interestRateBps": 1000, "termMonths": 3, "interestType": "REDUCING" }, "repayments": [], "asOfDay": 95,
      "expect": { "interestCents": 30000, "repaidCents": 0, "outstandingCents": 130000, "overpaidCents": 0, "settled": false } },
    { "name": "reducing, principal paid in month 1 lowers months 2 and 3", "loan": { "principalCents": 100000, "interestRateBps": 1000, "termMonths": 3, "interestType": "REDUCING" }, "repayments": [{ "day": 10, "cents": 50000 }], "asOfDay": 95,
      "expect": { "interestCents": 20000, "repaidCents": 50000, "outstandingCents": 70000, "overpaidCents": 0, "settled": false } },
    { "name": "reducing, payment in month 2 clears booked interest first", "loan": { "principalCents": 100000, "interestRateBps": 1000, "termMonths": 3, "interestType": "REDUCING" }, "repayments": [{ "day": 40, "cents": 20000 }], "asOfDay": 95,
      "expect": { "interestCents": 29000, "repaidCents": 20000, "outstandingCents": 109000, "overpaidCents": 0, "settled": false } },
    { "name": "reducing, payment exactly at a month end counts in the next month", "loan": { "principalCents": 100000, "interestRateBps": 1000, "termMonths": 3, "interestType": "REDUCING" }, "repayments": [{ "day": 30, "cents": 60000 }], "asOfDay": 95,
      "expect": { "interestCents": 25000, "repaidCents": 60000, "outstandingCents": 65000, "overpaidCents": 0, "settled": false } },
    { "name": "reducing, paid off in month 2 - interest stops there", "loan": { "principalCents": 100000, "interestRateBps": 1000, "termMonths": 3, "interestType": "REDUCING" }, "repayments": [{ "day": 35, "cents": 110000 }], "asOfDay": 120,
      "expect": { "interestCents": 10000, "repaidCents": 110000, "outstandingCents": 0, "overpaidCents": 0, "settled": true } },
    { "name": "reducing, rounding per month to the cent", "loan": { "principalCents": 33333, "interestRateBps": 750, "termMonths": 2, "interestType": "REDUCING" }, "repayments": [{ "day": 5, "cents": 10000 }], "asOfDay": 60,
      "expect": { "interestCents": 4250, "repaidCents": 10000, "outstandingCents": 27583, "overpaidCents": 0, "settled": false } },
    { "name": "reducing, a repayment after the as-of day is not counted", "loan": { "principalCents": 100000, "interestRateBps": 1000, "termMonths": 3, "interestType": "REDUCING" }, "repayments": [{ "day": 70, "cents": 50000 }], "asOfDay": 65,
      "expect": { "interestCents": 20000, "repaidCents": 0, "outstandingCents": 120000, "overpaidCents": 0, "settled": false } },
    { "name": "zero rate charges nothing", "loan": { "principalCents": 250000, "interestRateBps": 0, "termMonths": 6, "interestType": "REDUCING" }, "repayments": [{ "day": 45, "cents": 100000 }], "asOfDay": 200,
      "expect": { "interestCents": 0, "repaidCents": 100000, "outstandingCents": 150000, "overpaidCents": 0, "settled": false } },
    { "name": "unknown type is treated as flat", "loan": { "principalCents": 100000, "interestRateBps": 500, "termMonths": 2, "interestType": "SOMETHING_ELSE" }, "repayments": [{ "day": 10, "cents": 50000 }], "asOfDay": 61,
      "expect": { "interestCents": 10000, "repaidCents": 50000, "outstandingCents": 60000, "overpaidCents": 0, "settled": false } }
  ]
}
