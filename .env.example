# Copy to .env before building (the file is a pubspec asset, so it must exist).
#
# PRODUCTION: https://intellicash.co.ke/api/v1
# Local dev  : http://localhost:4000/api/v1  (adb reverse tcp:4000 tcp:4000)
# Release builds refuse localhost and plain http.
IC_BASE_URL=https://intellicash.co.ke/api/v1

# Debug convenience only. Release IGNORES this - an APK is a public artifact
# and anyone can unzip it - so release authenticates by password instead.
#IC_API_KEY=
