# Backend connection — copy to `.env` and fill in real values.
# The app reads these at startup as its default cloud configuration, so the
# API key never has to be typed into (or hardcoded inside) the app itself.
# A value saved from the in-app Cloud Account screen still overrides these.

# Base URL of the IntelliCash API (with or without the /api/v1 suffix).
# Android emulator reaches the host machine at 10.0.2.2; a physical phone
# uses the host's LAN IP or `adb reverse` + localhost.
IC_BASE_URL=http://10.0.2.2:4000/api/v1

# Mobile API key (MOBILE_CORE preset), minted by an IWL admin via
# POST /api/v1/api-keys. Starts with ic_sk_.
IC_API_KEY=
