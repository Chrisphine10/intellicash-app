# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing material — never commit
upload-keystore.jks
*.jks
*.keystore
upload_certificate.pem
android/key.properties

# Backend configuration (API keys) — never commit real credentials.
.env

# Backups of .env. The pattern above only catches the exact name, and a
# timestamped copy (.env.bak-20260728) carried a live IC_API_KEY into
# `git add -A`. This repository is public.
.env.*
*.env.bak*

# Android signing material. The upload certificate and any keystore must
# never be published — losing control of them means losing control of who
# can ship an update to this app.
*.der
*.jks
*.keystore
play-store/upload_certificate.der
